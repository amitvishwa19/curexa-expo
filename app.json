{
  "expo": {
    "name": "Curexa",
    "slug": "curexa",
    "version": "4.0.0",
    "orientation": "default",
    "icon": "./src/assets/images/app-icon.png",
    "scheme": "curexa",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/images/app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff",
      "dark": {
        "image": "./src/assets/images/app-icon.png",
        "backgroundColor": "#020714",
        "resizeMode": "contain"
      }
    },
    "ios": {
      "supportsTablet": true,
      "splash": {
        "image": "./src/assets/images/app-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff",
        "dark": {
          "image": "./src/assets/images/app-icon.png",
          "backgroundColor": "#020714",
          "resizeMode": "contain"
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/app-icon.png",
        "backgroundColor": "#ffffff"
      },
      "splash": {
        "image": "./src/assets/images/app-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff",
        "dark": {
          "image": "./src/assets/images/app-icon.png",
          "backgroundColor": "#020714",
          "resizeMode": "contain"
        }
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.devlomatixsolutions.curexa",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDKJlN8AeS6QZNL5vZMbOOIWFJ2LkVW81o"
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-secure-store",
      "@react-native-google-signin/google-signin",
      "expo-font",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ],
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location.",
          "isAndroidBackgroundLocationEnabled": "Allow App to use your location in the background"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging"
    ],
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/assets/images/app-icon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4826e355-372a-4b1a-927e-0a203f620181"
      }
    }
  }
}
